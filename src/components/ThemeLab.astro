---
import {
  THEME_AVATARS,
  THEME_FONTS,
  THEME_MODES,
  THEME_PALETTES,
} from "../features/theme/registry";
---

<aside
  class="theme-lab t-morph"
  data-open="false"
  data-theme-lab
  aria-label="Theme customization"
>
  <section
    id="theme-lab-panel"
    class="tl-panel t-morph-menu"
    role="dialog"
    aria-modal="false"
    aria-label="Theme lab"
    aria-hidden="true"
    tabindex="-1"
    data-theme-panel
    hidden
    inert
  >
    <header class="tl-head">
      <h2 class="tl-title">Theme lab</h2>
      <button
        type="button"
        class="tl-icon-btn"
        data-theme-close
        aria-label="Close theme lab"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </header>

    <div class="tl-body">
      <div class="tl-section">
        <span class="tl-label">Mode</span>
        <div class="tl-seg" role="group" aria-label="Color mode">
          {
            THEME_MODES.map((mode) => (
              <button
                type="button"
                data-mode={mode.id}
                aria-pressed="false"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  {mode.icon === "sun" ? (
                    <>
                      <circle cx="12" cy="12" r="4"></circle>
                      <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
                    </>
                  ) : (
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
                  )}
                </svg>
                {mode.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="tl-section">
        <span class="tl-label">Profiles</span>
        <div class="tl-palettes" role="group" aria-label="Theme profiles">
          {
            THEME_PALETTES.map((palette) => (
              <button
                type="button"
                class="tl-palette"
                data-palette={palette.id}
                data-accent={palette.accent}
                aria-label={`${palette.name} profile`}
                title={palette.name}
                aria-pressed="false"
                style={`--swatch:${palette.accent}`}
              />
            ))
          }
        </div>
      </div>

      <div class="tl-section">
        <span class="tl-label">Typeface</span>
        <div class="tl-selects">
          <label class="tl-select-row">
            <span class="tl-select-label">Title</span>
            <span class="tl-select-wrap">
              <select
                class="tl-select"
                data-font-choice="heading"
                aria-label="Title font"
              >
                {
                  THEME_FONTS.map((font) => (
                    <option value={font.id} style={`font-family:${font.stack}`}>
                      {font.name}
                    </option>
                  ))
                }
              </select>
            </span>
          </label>
          <label class="tl-select-row">
            <span class="tl-select-label">Body</span>
            <span class="tl-select-wrap">
              <select
                class="tl-select"
                data-font-choice="body"
                aria-label="Body font"
              >
                {
                  THEME_FONTS.map((font) => (
                    <option value={font.id} style={`font-family:${font.stack}`}>
                      {font.name}
                    </option>
                  ))
                }
              </select>
            </span>
          </label>
        </div>
      </div>

      <div class="tl-section">
        <span class="tl-label">Surface</span>
        <div class="tl-toggles">
          <div class="tl-toggle">
            <span class="tl-toggle__label">Borders</span>
            <button
              type="button"
              class="tl-switch"
              role="switch"
              aria-checked="true"
              aria-label="Toggle borders"
              data-theme-borders
            >
              <span class="tl-switch__thumb" aria-hidden="true"></span>
            </button>
          </div>
          <div class="tl-toggle">
            <span class="tl-toggle__label">Shadows</span>
            <button
              type="button"
              class="tl-switch"
              role="switch"
              aria-checked="true"
              aria-label="Toggle shadows"
              data-theme-shadows
            >
              <span class="tl-switch__thumb" aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="tl-subsection">
          <span class="tl-label">Avatar</span>
          <div class="tl-seg tl-seg--avatar" role="group" aria-label="Avatar">
            {
              THEME_AVATARS.map((preset) => (
                <button
                  type="button"
                  data-avatar-preset={preset.id}
                  aria-label={`${preset.name} avatar`}
                  title={preset.name}
                  aria-pressed="false"
                >
                  <span
                    class={`tl-shape__glyph tl-shape__glyph--${preset.id}`}
                    aria-hidden="true"
                  />
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <footer class="tl-foot">
      <div class="tl-actions">
        <button
          type="button"
          class="tl-action tl-action--primary"
          data-theme-shuffle
        >
          Surprise me
        </button>
        <button type="button" class="tl-action" data-theme-reset>
          Reset
        </button>
      </div>
    </footer>
  </section>

  <button
    type="button"
    class="tl-trigger t-morph-plus"
    data-theme-trigger
    aria-expanded="false"
    aria-controls="theme-lab-panel"
    aria-label="Open theme lab"
    title="Theme lab"
  >
    <svg
      class="tl-trigger__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3"></path>
      <path d="M1 14h6M9 8h6M17 16h6"></path>
    </svg>
  </button>
</aside>

<style>
  .theme-lab {
    --tl-top: max(1rem, env(safe-area-inset-top));
    --tl-bottom: max(1rem, env(safe-area-inset-bottom));
    --tl-inline-start: max(var(--page-inline-padding), env(safe-area-inset-left));
    --tl-inline-end: max(var(--page-inline-padding), env(safe-area-inset-right));
    --morph-open-w: min(336px, calc(100vw - 2rem));
    position: fixed;
    top: var(--tl-top);
    right: max(1rem, env(safe-area-inset-right));
    z-index: 80;
    width: 44px;
    height: 44px;
    overflow: hidden;
    color: var(--text-strong);
    background: var(--card-bg);
    border-radius: var(--morph-r-closed);
    box-shadow: var(--shadow-border);
    transition:
      width var(--morph-close-dur) var(--morph-close-ease),
      height var(--morph-close-dur) var(--morph-close-ease),
      border-radius var(--morph-close-dur) var(--morph-close-ease),
      box-shadow var(--morph-close-dur) var(--morph-close-ease);
    -webkit-tap-highlight-color: transparent;
  }

  .theme-lab[data-open="true"] {
    width: var(--morph-open-w, 336px);
    height: min(
      var(--morph-open-h, 560px),
      calc(100dvh - var(--tl-top) - var(--tl-bottom))
    );
    border-radius: var(--morph-r-open);
    box-shadow: var(--shadow-card);
    transition:
      width var(--morph-open-dur) var(--morph-ease),
      height var(--morph-open-dur) var(--morph-ease),
      border-radius var(--morph-open-dur) var(--morph-ease),
      box-shadow var(--morph-open-dur) var(--morph-ease);
  }

  .theme-lab.is-measuring {
    width: var(--morph-open-w, 336px);
    height: auto;
    visibility: hidden;
    border-radius: var(--morph-r-open);
    box-shadow: none;
    transition: none;
  }

  .tl-trigger {
    position: absolute;
    inset: 0 0 auto auto;
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    color: var(--text-strong);
    cursor: pointer;
    background: var(--chip-bg);
    border: 0;
    border-radius: var(--morph-r-closed);
    transition:
      opacity var(--morph-fade-dur) var(--morph-close-ease),
      transform var(--morph-open-dur) var(--morph-close-ease),
      filter var(--morph-fade-dur) var(--morph-close-ease),
      background-color 180ms ease;
  }

  .tl-trigger:hover {
    background: var(--chip-bg-hover);
  }

  .tl-trigger:active {
    transform: scale(0.96);
  }

  .tl-trigger:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .theme-lab[data-open="true"] .tl-trigger {
    opacity: 0;
    filter: blur(var(--morph-blur));
    pointer-events: none;
    transform: translateX(calc(-1 * var(--morph-slide)));
  }

  .tl-trigger__icon {
    width: 19px;
    height: 19px;
    transition: transform var(--morph-open-dur) var(--morph-close-ease);
  }

  .theme-lab[data-open="true"] .tl-trigger__icon {
    transform: scale(var(--morph-scale)) rotate(var(--morph-rotate));
  }

  .tl-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: inherit;
    opacity: 0;
    transform: translateX(var(--morph-slide)) scale(var(--morph-scale));
    filter: blur(var(--morph-blur));
    pointer-events: none;
    transition:
      opacity var(--morph-fade-dur) var(--morph-close-ease),
      transform var(--morph-open-dur) var(--morph-close-ease),
      filter var(--morph-fade-dur) var(--morph-close-ease);
  }

  .theme-lab[data-open="true"] .tl-panel {
    opacity: 1;
    filter: blur(0);
    pointer-events: auto;
    transform: translateX(0) scale(1);
  }

  .theme-lab.is-measuring .tl-panel {
    position: relative;
    inset: auto;
    height: auto;
    opacity: 1;
    filter: none;
    transform: none;
    transition: none;
  }

  .tl-panel:focus {
    outline: none;
  }

  .tl-head {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 16px 12px;
    border-bottom: 1px solid var(--card-border);
  }

  .tl-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .tl-icon-btn {
    display: grid;
    flex: none;
    width: 28px;
    height: 28px;
    padding: 0;
    place-items: center;
    color: var(--text-muted);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: 8px;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .tl-icon-btn:hover {
    color: var(--text-strong);
    background: var(--chip-bg);
  }

  .tl-icon-btn:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }

  .tl-icon-btn svg {
    width: 16px;
    height: 16px;
  }

  .tl-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 18px;
    padding: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .tl-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tl-label {
    font-family: inherit;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .tl-seg {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    height: 30px;
    padding: 3px;
    background: var(--chip-bg);
    border-radius: 8px;
  }

  .tl-seg button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 24px;
    padding: 0 6px;
    font-family: inherit;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: 6px;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .tl-seg button svg {
    width: 13px;
    height: 13px;
  }

  .tl-seg button:hover {
    color: var(--text-strong);
  }

  .tl-seg button[aria-pressed="true"] {
    color: var(--text-strong);
    background: var(--card-bg);
  }

  .tl-seg button:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }

  .tl-seg--avatar {
    grid-template-columns: repeat(4, 1fr);
  }

  .tl-shape__glyph {
    display: block;
    width: 15px;
    height: 15px;
    background: currentColor;
    transition:
      background-color 150ms ease,
      border-radius 150ms ease;
  }

  .tl-shape__glyph--circle {
    border-radius: 999px;
  }

  .tl-shape__glyph--squircle {
    border-radius: 34%;
  }

  .tl-shape__glyph--square {
    border-radius: 4px;
  }

  .tl-shape__glyph--check {
    width: 17px;
    height: 17px;
    border-radius: 0;
    -webkit-mask: var(--mask-verified) center / contain no-repeat;
    mask: var(--mask-verified) center / contain no-repeat;
  }

  .tl-palettes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .tl-palette {
    height: 30px;
    padding: 0;
    cursor: pointer;
    background: var(--swatch);
    border: 0;
    border-radius: 6px;
    opacity: 0.55;
    transition:
      opacity 150ms ease,
      transform 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tl-palette:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .tl-palette:active {
    transform: scale(0.97);
  }

  .tl-palette[aria-pressed="true"] {
    opacity: 1;
  }

  .tl-palette:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .tl-selects {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-select-row {
    display: flex;
    height: 34px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tl-select-label {
    font-size: 12px;
    color: var(--text-strong);
  }

  .tl-select-wrap {
    position: relative;
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .tl-select {
    width: 190px;
    max-width: 100%;
    height: 30px;
    padding: 0 26px 0 10px;
    overflow: hidden;
    font-family: inherit;
    font-size: 11px;
    color: var(--text-strong);
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
    appearance: none;
    cursor: pointer;
    background: var(--chip-bg);
    border: 0;
    border-radius: 8px;
  }

  .tl-select:hover {
    background: var(--chip-bg-hover);
  }

  .tl-select:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }

  .tl-select-wrap::after {
    position: absolute;
    top: 50%;
    right: 10px;
    width: 6px;
    height: 6px;
    pointer-events: none;
    content: "";
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: translateY(-65%) rotate(45deg);
  }

  .tl-toggles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-toggle {
    display: flex;
    height: 34px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tl-toggle__label {
    font-size: 12px;
    color: var(--text-strong);
  }

  .tl-switch {
    position: relative;
    width: 32px;
    height: 18px;
    padding: 0;
    cursor: pointer;
    background: var(--chip-bg-hover);
    border: 0;
    border-radius: 999px;
    transition: background-color 150ms ease;
  }

  .tl-switch__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    background: var(--text-muted);
    border-radius: 999px;
    transition:
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 150ms ease;
  }

  .tl-switch[aria-checked="true"] {
    background: var(--primary);
  }

  .tl-switch[aria-checked="true"] .tl-switch__thumb {
    background: var(--primary-foreground);
    transform: translateX(14px);
  }

  .tl-switch:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .tl-subsection {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .tl-foot {
    display: flex;
    flex: none;
    flex-direction: column;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--card-border);
  }

  .tl-actions {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }

  .tl-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 12px;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-strong);
    cursor: pointer;
    background: var(--chip-bg);
    border: 0;
    border-radius: 9px;
    transition:
      transform 150ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 150ms ease,
      color 150ms ease;
  }

  .tl-action:hover {
    background: var(--chip-bg-hover);
  }

  .tl-action:active {
    transform: scale(0.98);
  }

  .tl-action:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .tl-action--primary {
    color: var(--primary-foreground);
    background: var(--primary);
  }

  .tl-action--primary:hover {
    background: color-mix(in oklab, var(--primary) 88%, var(--text-strong));
  }

  @media (width < 48rem) {
    .theme-lab {
      --morph-open-w: calc(100vw - var(--tl-inline-start) - var(--tl-inline-end));
      top: auto;
      right: var(--tl-inline-end);
      bottom: var(--tl-bottom);
    }

    .tl-trigger {
      inset: auto 0 0 auto;
    }

    .tl-panel {
      transform-origin: bottom right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-lab,
    .tl-trigger,
    .tl-trigger__icon,
    .tl-panel,
    .tl-palette,
    .tl-select,
    .tl-switch,
    .tl-switch__thumb,
    .tl-shape__glyph,
    .tl-action {
      transition: none !important;
    }
  }
</style>

<script src="../features/theme/controller.ts"></script>
