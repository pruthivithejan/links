---
interface Card {
  href: string;
  icon: string;
  title: string;
  description: string;
}

interface Props {
  links: Card[];
}

const { links } = Astro.props;
---

<!-- Links Grid Section -->
<section class="w-full flex justify-center">
  <div
    class="grid w-full max-w-200 auto-rows-fr grid-cols-1 items-stretch gap-4 px-4 lg:grid-cols-2"
  >
    {
      links.map((card: Card, index: number) => (
        <a
          href={card.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex h-full cursor-pointer flex-col overflow-visible rounded-(--radius-card) border border-(--card-border) bg-(--card-bg) p-4 text-(--foreground) no-underline opacity-0 shadow-(--shadow-card) transition-[border-color,box-shadow,background-color] duration-150 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] hover:border-(--card-border-hover) hover:bg-(--card-bg-hover) md:p-5"
          style={`--stagger: ${index + 3}`}
        >
          <h2 class="font-semibold leading-none tracking-tight mb-2 flex items-center gap-2 text-base sm:text-lg transition-colors group-hover:text-(--foreground)">
            <img
              src={`/icons/${card.icon}.svg`}
              alt={`${card.title} Icon`}
              class="h-6 w-6 shrink-0 filter-(--icon-filter) transition-[filter] duration-200"
              width={24}
              height={24}
            />
            {card.title}
            <span class="inline-block font-mono transition-transform duration-200 group-hover:animate-[card-hover-arrow_200ms_forwards]">
              <img
                src="/arrow-right.svg"
                alt="Arrow Right"
                class="h-8 w-8 filter-(--icon-filter) transition-[filter] duration-200"
                width={16}
                height={16}
              />
            </span>
          </h2>
          <p class="m-0 text-sm leading-relaxed max-w-none md:max-w-[34ch] text-(--text-subtle)">
            {card.description}
          </p>

          <button
            type="button"
            class="card-copy group/copy absolute right-4 top-4 z-10 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-(--radius-copy) border-0 bg-(--copy-bg-tint) p-0 text-(--icon-color-muted) opacity-0 bg-[linear-gradient(90deg,var(--copy-bg)_0%,var(--copy-bg)_100%)] [-webkit-tap-highlight-color:transparent] transition-[background-color,color,opacity] duration-150 group-hover:opacity-100 group-focus-within:opacity-100 hover:bg-(--copy-bg-tint) hover:text-(--icon-color) hover:bg-[linear-gradient(90deg,var(--copy-bg-hover)_0%,var(--copy-bg-hover)_100%)] active:bg-(--copy-bg-tint) active:text-(--icon-color) active:bg-[linear-gradient(90deg,var(--copy-bg-pressed)_0%,var(--copy-bg-pressed)_100%)] focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--icon-color) dark:bg-(--copy-bg) dark:bg-none dark:hover:bg-(--copy-bg-hover) dark:hover:bg-none dark:active:bg-(--copy-bg-pressed) dark:active:bg-none"
            data-clipboard-text={card.href}
            aria-label="Copy link"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-copy absolute left-1/2 top-1/2 block h-4 w-4 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity,transform] group-data-[copied=true]/copy:scale-25 group-data-[copied=true]/copy:opacity-0"
              aria-hidden="true"
            >
              <>
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
              </>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon-check absolute left-1/2 top-1/2 block h-4 w-4 -translate-x-1/2 -translate-y-1/2 scale-25 opacity-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity,transform] group-data-[copied=true]/copy:scale-100 group-data-[copied=true]/copy:opacity-100"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span
              class="card-copy-tooltip pointer-events-none invisible absolute bottom-[calc(100%+8px)] left-1/2 z-10 box-border inline-flex h-8 -translate-x-1/2 items-center whitespace-nowrap rounded-full bg-white px-3 text-xs font-normal leading-4 text-[#17181c] opacity-0 shadow-(--shadow-tooltip) [transition:opacity_150ms_cubic-bezier(0.22,1,0.36,1),visibility_0s_linear_150ms] group-hover/copy:visible group-hover/copy:opacity-100 group-hover/copy:delay-[50ms,50ms] group-focus-visible/copy:visible group-focus-visible/copy:opacity-100 group-focus-visible/copy:delay-[50ms,50ms] group-data-[copied=true]/copy:visible group-data-[copied=true]/copy:opacity-100 group-data-[copied=true]/copy:delay-[0ms,0ms] dark:bg-[#181818] dark:text-[#e3e3e3]"
              role="tooltip"
              aria-hidden="true"
            >
              <span class="tt-text inline-flex items-baseline leading-4">
                <span class="tt-stem">Cop</span>
                <span
                  class="tt-swap group/swap relative inline-block w-(--tt-w-a,auto) align-baseline leading-4 transition-[width] duration-240 ease-[cubic-bezier(0.22,1,0.36,1)] data-[state=copied]:w-(--tt-w-b,auto)"
                  data-state="copy"
                >
                  <span class="tt-label tt-a inline-block whitespace-pre opacity-100 transition-opacity duration-180 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity] group-data-[state=copied]/swap:opacity-0">
                    y link
                  </span>
                  <span class="tt-label tt-b absolute left-0 top-0 whitespace-pre opacity-0 transition-opacity duration-180 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity] group-data-[state=copied]/swap:opacity-100">
                    ied
                  </span>
                </span>
              </span>
            </span>
          </button>
        </a>
      ))
    }
  </div>
</section>

<script>
  const measureTooltipWidths = (button: HTMLButtonElement) => {
    const swap = button.querySelector<HTMLElement>(".tt-swap");
    const tooltip = button.querySelector<HTMLElement>(".card-copy-tooltip");

    if (!swap || !tooltip) {
      return;
    }

    const measurer = document.createElement("div");
    measurer.setAttribute("aria-hidden", "true");
    measurer.style.cssText =
      "position:absolute;left:-9999px;top:0;visibility:hidden;pointer-events:none;";
    document.body.append(measurer);

    // SAFETY: cloning an element node always returns an element.
    const clone = tooltip.cloneNode(true) as HTMLElement;
    clone.style.visibility = "hidden";
    clone.style.opacity = "0";
    clone.style.display = "inline-flex";
    measurer.append(clone);

    const widths: number[] = [];

    for (const label of clone.querySelectorAll<HTMLElement>(".tt-label")) {
      label.style.position = "static";
      label.style.display = "inline-block";
      widths.push(label.getBoundingClientRect().width);
    }

    measurer.remove();

    if (widths[0]) {
      swap.style.setProperty("--tt-w-a", `${widths[0]}px`);
    }

    if (widths[1]) {
      swap.style.setProperty("--tt-w-b", `${widths[1]}px`);
    }
  };

  const fallbackCopy = (text: string, onDone: () => void) => {
    try {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.append(textarea);
      textarea.select();
      document.execCommand("copy");
      textarea.remove();
      onDone();
    } catch {
      /* ignore */
    }
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".card-copy"
  )) {
    measureTooltipWidths(button);

    button.addEventListener("click", async (event) => {
      event.preventDefault();
      event.stopPropagation();

      const text = button.dataset.clipboardText;

      if (!text) {
        return;
      }

      const markCopied = () => {
        button.dataset.copied = "true";
        const swap = button.querySelector(".tt-swap");

        if (swap) {
          swap.dataset.state = "copied";
        }

        const isTouch = window.matchMedia?.("(hover: none)").matches;
        const dwell = isTouch ? 2000 : 1600;

        window.setTimeout(() => {
          delete button.dataset.copied;
          window.setTimeout(() => {
            if (swap) {
              swap.dataset.state = "copy";
            }
          }, 200);
        }, dwell);
      };

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          markCopied();
        } else {
          fallbackCopy(text, markCopied);
        }
      } catch {
        fallbackCopy(text, markCopied);
      }
    });
  }
</script>
