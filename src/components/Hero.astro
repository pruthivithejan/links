---
interface Props {
  githubUsername: string;
  profileName?: string;
  profileBio?: string;
}

const { githubUsername, profileName, profileBio } = Astro.props;
const displayName = profileName || githubUsername;
---

<section
  class="w-full flex flex-col items-center justify-center gap-2 md:gap-3"
>
  <div class="flex items-center justify-center px-4 pt-4 md:pt-6">
    <div class="avatar-stage">
      <div class="avatar">
        <img
          src={`https://avatars.githubusercontent.com/${githubUsername}`}
          alt={displayName}
          width={128}
          height={128}
          class="avatar__image"
        />
      </div>
    </div>
  </div>

  <div
    class="flex flex-col items-center px-4 opacity-0 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)]"
    style={`--stagger: 2`}
  >
    <h1
      class="m-0 text-center text-[40px] font-semibold leading-(--font-heading-leading) tracking-(--font-heading-tracking) text-(--text-strong)"
    >
      {displayName}
    </h1>
    {
      profileBio ? (
        <p class="mb-0 mt-1.75 max-w-140 text-center text-[16px] font-[425] not-italic leading-[24px] text-(--text-muted)">
          {profileBio}
        </p>
      ) : null
    }
  </div>
</section>
