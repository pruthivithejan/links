---
import CopyButton from "../ui/CopyButton.astro";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<CopyButton
  text={href}
  label="Copy link"
  copiedLabel="Copied"
  copiedStatus="Link copied."
  errorStatus="Could not copy link."
  position="absolute"
  class="copy-link right-4 top-4 z-10 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100"
/>

<style>
  @media (hover: none) {
    .copy-link {
      opacity: 1;
    }
  }
</style>
