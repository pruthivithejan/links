---
import generatedPreviews from "../data/link-previews.json";

interface QuickLink {
  href: string;
  icon: string;
  label: string;
  preview?: {
    title?: string;
    description?: string;
    meta?: string;
    image?: string;
    site?: string;
    description_manual?: string;
  };
}

interface Props {
  links: QuickLink[];
}

const { links } = Astro.props;

type Preview = {
  title?: string;
  description?: string;
  meta?: string;
  image?: string;
  site?: string;
};

const generatedByHref = generatedPreviews as Record<
  string,
  Preview | undefined
>;

const hostname = (href: string) => {
  try {
    return new URL(href).hostname;
  } catch {
    return href.replace(/^mailto:/, "");
  }
};

const safeId = (value: string) => value.replace(/[^a-zA-Z0-9_-]/g, "-");

const getPreview = (link: QuickLink): Preview => {
  const generated = generatedByHref[link.href] || {};
  const manual = link.preview || {};
  const merged = {
    ...generated,
    ...manual,
    meta: manual.meta || generated.site || generated.meta,
    title: manual.title || generated.title,
    image: manual.image || generated.image,
    description: manual.description || generated.description,
  };

  // Server-side check for GitHub profiles to pre-render the contribution graph
  try {
    const parsed = new URL(link.href);
    if (parsed.hostname.includes("github.com")) {
      const pathParts = parsed.pathname.split("/").filter(Boolean);
      const reservedKeywords = [
        "features",
        "about",
        "blog",
        "search",
        "explore",
        "trending",
        "settings",
        "notifications",
      ];
      if (pathParts.length === 1 && !reservedKeywords.includes(pathParts[0])) {
        merged.image = `https://ghchart.rshah.org/${pathParts[0]}`;
      }
    }
  } catch {}

  return merged;
};

const checkGitHub = (href: string) => {
  try {
    const parsed = new URL(href);
    if (parsed.hostname.includes("github.com")) {
      const pathParts = parsed.pathname.split("/").filter(Boolean);
      const reservedKeywords = [
        "features",
        "about",
        "blog",
        "search",
        "explore",
        "trending",
        "settings",
        "notifications",
      ];
      return pathParts.length === 1 && !reservedKeywords.includes(pathParts[0]);
    }
  } catch {}
  return false;
};
---

{
  links?.length ? (
    <nav class="w-full flex justify-center" aria-label="Quick links">
      <div class="w-full max-w-275 flex flex-wrap items-center justify-center gap-3 px-4">
        {links.map((link: QuickLink, index: number) => {
          const preview = getPreview(link);
          const isGH = checkGitHub(link.href);
          const canFetchImage = /^https?:\/\//.test(link.href);
          return (
            <div
              class="group relative"
              style={`--stagger: ${index}`}
              data-hovercard
              data-url={link.href}
            >
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="quick-link inline-flex h-11 items-center justify-center gap-2.5 whitespace-nowrap rounded-(--radius-chip) border-0 bg-(--chip-bg) px-5 py-2.5 text-base font-medium text-(--foreground) opacity-0 shadow-(--shadow-border) transition-[background-color,box-shadow,color] duration-150 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] hover:bg-(--chip-bg-hover) hover:text-(--foreground) active:bg-(--chip-bg-pressed) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--icon-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--background) disabled:pointer-events-none disabled:opacity-50 [&_img]:pointer-events-none [&_img]:h-5 [&_img]:w-5 [&_img]:shrink-0"
                aria-describedby={`hovercard-${safeId(link.label)}-${index}`}
              >
                <img
                  src={`/icons/${link.icon}.svg`}
                  alt=""
                  class="filter-(--icon-filter) transition-[filter] duration-200"
                  width={16}
                  height={16}
                  loading="lazy"
                />
                <span>{link.label}</span>
              </a>

              <div
                id={`hovercard-${safeId(link.label)}-${index}`}
                role="tooltip"
                class="hovercard-panel pointer-events-none absolute left-1/2 top-[calc(100%+12px)] z-20 w-80 -translate-x-1/2 scale-[0.97] rounded-[14px] border border-(--card-border) bg-(--card-bg) opacity-0 shadow-(--material-shadow) transition-[opacity,transform] duration-(--dropdown-close-dur,150ms) ease-[cubic-bezier(0.22,1,0.36,1)] transform-gpu before:absolute before:inset-x-0 before:-top-4 before:h-4 before:content-[''] group-hover:pointer-events-auto group-hover:scale-100 group-hover:opacity-100 group-hover:duration-250 group-focus-within:pointer-events-auto group-focus-within:scale-100 group-focus-within:opacity-100 group-focus-within:duration-250"
              >
                <button
                  type="button"
                  class="card-copy hovercard-copy group/copy absolute right-3 top-5.5 z-30 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-(--radius-copy) border-0 bg-(--copy-bg-tint) p-0 text-(--icon-color-muted) opacity-0 bg-[linear-gradient(90deg,var(--copy-bg)_0%,var(--copy-bg)_100%)] [-webkit-tap-highlight-color:transparent] transition-[background-color,color,opacity] duration-150 group-hover:opacity-100 group-focus-within:opacity-100 hover:bg-(--copy-bg-tint) hover:text-(--icon-color) hover:bg-[linear-gradient(90deg,var(--copy-bg-hover)_0%,var(--copy-bg-hover)_100%)] active:bg-(--copy-bg-tint) active:text-(--icon-color) active:bg-[linear-gradient(90deg,var(--copy-bg-pressed)_0%,var(--copy-bg-pressed)_100%)] focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--icon-color) dark:bg-(--copy-bg) dark:bg-none dark:hover:bg-(--copy-bg-hover) dark:hover:bg-none dark:active:bg-(--copy-bg-pressed) dark:active:bg-none"
                  data-clipboard-text={link.href}
                  aria-label={`Copy ${link.label} link`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon-copy absolute left-1/2 top-1/2 block h-4 w-4 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity,transform] group-data-[copied=true]/copy:scale-25 group-data-[copied=true]/copy:opacity-0"
                    aria-hidden="true"
                  >
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon-check absolute left-1/2 top-1/2 block h-4 w-4 -translate-x-1/2 -translate-y-1/2 scale-25 opacity-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity,transform] group-data-[copied=true]/copy:scale-100 group-data-[copied=true]/copy:opacity-100"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span
                    class="card-copy-tooltip pointer-events-none invisible absolute left-1/2 top-[calc(100%+8px)] z-10 box-border inline-flex h-8 -translate-x-1/2 items-center whitespace-nowrap rounded-full bg-white px-3 text-xs font-normal leading-4 text-[#17181c] opacity-0 shadow-(--shadow-tooltip) [transition:opacity_150ms_cubic-bezier(0.22,1,0.36,1),visibility_0s_linear_150ms] group-hover/copy:visible group-hover/copy:opacity-100 group-hover/copy:delay-[50ms,50ms] group-focus-visible/copy:visible group-focus-visible/copy:opacity-100 group-focus-visible/copy:delay-[50ms,50ms] group-data-[copied=true]/copy:visible group-data-[copied=true]/copy:opacity-100 group-data-[copied=true]/copy:delay-[0ms,0ms] dark:bg-[#181818] dark:text-[#e3e3e3]"
                    role="tooltip"
                    aria-hidden="true"
                  >
                    <span class="tt-text inline-flex items-baseline leading-4">
                      <span class="tt-stem">Cop</span>
                      <span
                        class="tt-swap group/swap relative inline-block w-(--tt-w-a,auto) align-baseline leading-4 transition-[width] duration-240 ease-[cubic-bezier(0.22,1,0.36,1)] data-[state=copied]:w-(--tt-w-b,auto)"
                        data-state="copy"
                      >
                        <span class="tt-label tt-a inline-block whitespace-pre opacity-100 transition-opacity duration-180 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity] group-data-[state=copied]/swap:opacity-0">
                          y link
                        </span>
                        <span class="tt-label tt-b absolute left-0 top-0 whitespace-pre opacity-0 transition-opacity duration-180 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity] group-data-[state=copied]/swap:opacity-100">
                          ied
                        </span>
                      </span>
                    </span>
                  </span>
                </button>

                <div class="flex flex-col gap-3 p-4">
                  <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-(--muted)">
                      <img
                        src={`/icons/${link.icon}.svg`}
                        alt=""
                        class="h-6 w-6 filter-(--icon-filter) transition-[filter] duration-200"
                        loading="lazy"
                      />
                    </div>
                    <div class="min-w-0 flex-grow pr-11">
                      <p class="hovercard-title truncate text-sm font-semibold leading-tight">
                        {preview.title || link.label}
                      </p>
                      <p class="hovercard-meta truncate text-xs text-(--muted-foreground)">
                        {preview.meta || hostname(link.href)}
                      </p>
                    </div>
                  </div>

                  <div
                    class={`hovercard-desc text-xs text-(--muted-foreground) leading-normal mt-0.5 ${preview.description ? "" : "hidden"}`}
                  >
                    {preview.description && (
                      <p class="m-0">{preview.description}</p>
                    )}
                  </div>

                  {(preview.image || canFetchImage) && (
                    <div
                      class={`hovercard-image-container overflow-hidden rounded-lg border border-(--border) bg-(--muted) ${preview.image ? "" : "hidden"}`}
                    >
                      <img
                        src={preview.image}
                        alt=""
                        class={`hovercard-image h-44 w-full transition-opacity duration-300 opacity-100 ${isGH ? "object-contain p-3 bg-white dark:bg-zinc-900" : "object-cover p-0"}`}
                        loading="lazy"
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </nav>
  ) : null
}

<script>
  // Client-side dynamic metadata fetching for hovercards
  const hovercards = document.querySelectorAll("[data-hovercard]");

  // Simple in-memory cache to prevent redundant API fetches
  const cache = new Map();

  const isGitHubProfile = (url: string) => {
    try {
      const parsed = new URL(url);
      if (parsed.hostname.includes("github.com")) {
        const pathParts = parsed.pathname.split("/").filter(Boolean);
        const reservedKeywords = [
          "features",
          "about",
          "blog",
          "search",
          "explore",
          "trending",
          "settings",
          "notifications",
        ];
        return (
          pathParts.length === 1 && !reservedKeywords.includes(pathParts[0])
        );
      }
    } catch {}
    return false;
  };

  const isUsablePreviewImage = (url: unknown) => {
    if (typeof url !== "string" || !url) return false;
    try {
      const parsed = new URL(url);
      return (
        /^https?:$/.test(parsed.protocol) &&
        !/\/image-default(?:\.[a-z0-9]+)?$/i.test(parsed.pathname)
      );
    } catch {
      return false;
    }
  };

  hovercards.forEach((card) => {
    const url = card.getAttribute("data-url");
    if (!url || !url.startsWith("http")) return;

    let isFetching = false;

    const fetchMetadata = async () => {
      if (isFetching || cache.has(url)) return;
      isFetching = true;

      const titleEl = card.querySelector(".hovercard-title");
      const metaEl = card.querySelector(".hovercard-meta");
      const imageContainerEl = card.querySelector(".hovercard-image-container");
      const imageEl = card.querySelector(
        ".hovercard-image",
      ) as HTMLImageElement | null;
      const descEl = card.querySelector(".hovercard-desc");

      // Check if we already have static content rendered
      const hasStaticImage =
        imageEl &&
        imageEl.getAttribute("src") &&
        imageEl.getAttribute("src") !== "";
      const hasStaticDesc =
        descEl && descEl.textContent && descEl.textContent.trim() !== "";

      // Show shimmer loading state if static content doesn't exist
      if (!hasStaticDesc && descEl) {
        descEl.classList.remove("hidden");
        descEl.innerHTML =
          '<div class="h-3 w-4/5 rounded bg-[color:var(--border)] animate-pulse mb-1"></div><div class="h-3 w-2/3 rounded bg-[color:var(--border)] animate-pulse"></div>';
      }

      try {
        const response = await fetch(
          `https://api.microlink.io/?url=${encodeURIComponent(url)}`,
        );
        if (!response.ok) throw new Error("Network response was not ok");
        const result = await response.json();

        if (result.status === "success" && result.data) {
          const data = result.data;

          // Cache the result
          cache.set(url, data);

          // 1. Update Title (if dynamic title exists and not already overridden manually)
          if (titleEl && data.title) {
            titleEl.textContent = data.title;
          }

          // 2. Update Meta
          if (metaEl && data.publisher) {
            metaEl.textContent = data.publisher;
          }

          // 3. Update Description
          if (descEl) {
            if (data.description) {
              descEl.classList.remove("hidden");
              descEl.innerHTML = `<p class="m-0 leading-normal text-xs text-[color:var(--muted-foreground)]">${data.description}</p>`;
            } else if (!hasStaticDesc) {
              descEl.classList.add("hidden");
            }
          }

          // 4. Update Image
          let imgUrl = data.image?.url || data.logo?.url;
          let isGH = false;

          if (isGitHubProfile(url)) {
            const username = new URL(url).pathname
              .split("/")
              .filter(Boolean)[0];
            imgUrl = `https://ghchart.rshah.org/${username}`;
            isGH = true;
          }

          if (!isUsablePreviewImage(imgUrl)) {
            imgUrl = undefined;
          }

          if (imgUrl && imageEl && imageContainerEl) {
            if (isGH) {
              imageEl.className =
                "hovercard-image h-44 w-full object-contain transition-opacity duration-300 opacity-0 p-3 bg-white dark:bg-zinc-900";
            } else {
              imageEl.className =
                "hovercard-image h-44 w-full object-cover transition-opacity duration-300 opacity-0 p-0";
            }
            imageEl.onload = () => {
              imageContainerEl.classList.remove("hidden");
              imageEl.classList.remove("opacity-0");
              imageEl.classList.add("opacity-100");
            };
            imageEl.onerror = () => {
              imageContainerEl.classList.add("hidden");
            };
            imageEl.setAttribute("src", imgUrl);
          } else if (imageContainerEl && !hasStaticImage) {
            imageContainerEl.classList.add("hidden");
          }
        }
      } catch (error) {
        console.error(
          `[Hovercard] Failed to dynamically fetch metadata for ${url}:`,
          error,
        );
        // Graceful cleanup on error
        if (imageContainerEl && !hasStaticImage) {
          imageContainerEl.classList.add("hidden");
        }
        if (descEl && !hasStaticDesc) {
          descEl.classList.add("hidden");
        }
      } finally {
        isFetching = false;
      }
    };

    // Trigger metadata fetch on hover or keyboard focus
    card.addEventListener("mouseenter", fetchMetadata);
    card.addEventListener("focusin", fetchMetadata);
  });
</script>
