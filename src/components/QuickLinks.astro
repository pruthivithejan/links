---
interface QuickLink {
  href: string;
  icon: string;
  label: string;
}

interface Props {
  links: QuickLink[];
}

const { links } = Astro.props;
---

{
  links?.length ? (
    <nav class="-mx-4 -mt-4 w-full flex justify-center sm:-mx-6 md:mx-0 md:-mt-8" aria-label="Quick links">
      <div class="flex w-full max-w-[25rem] flex-wrap items-center justify-center gap-1.5 md:max-w-[36rem]">
        {links.map((link: QuickLink, index: number) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="quick-link inline-flex h-9 items-center justify-center gap-1.5 whitespace-nowrap rounded-(--radius-chip) bg-(--chip-bg) px-3 text-[0.8125rem] font-medium text-(--foreground) no-underline opacity-0 shadow-(--shadow-border) transition-[background-color,box-shadow,color] duration-150 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] hover:bg-(--chip-bg-hover) hover:text-(--foreground) active:bg-(--chip-bg-pressed) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--icon-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--background) [&_img]:pointer-events-none [&_img]:h-3.5 [&_img]:w-3.5 [&_img]:shrink-0"
            style={`--stagger: ${index + 3}`}
          >
            <img
              src={`/icons/${link.icon}.svg`}
              alt=""
              class="filter-(--icon-filter) transition-[filter] duration-200"
              width={14}
              height={14}
              loading="lazy"
            />
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </nav>
  ) : null
}
