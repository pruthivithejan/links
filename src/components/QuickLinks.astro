---
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import type { QuickLink } from "../content/schemas.ts";

interface Props {
  links: QuickLink[];
}

const { links } = Astro.props;
---

{
  links.length ? (
    <nav
      class="-mx-4 -mt-4 w-full flex justify-center sm:-mx-6 md:mx-0 md:-mt-8"
      aria-label="Quick links"
    >
      <div class="flex w-full max-w-[25rem] flex-wrap items-center justify-center gap-1.5 md:max-w-[36rem]">
        {links.map((link, index) => (
          <Button
            href={link.href}
            variant="chip"
            class="quick-link opacity-0 animate-[enter_500ms_forwards]"
            style={`--stagger: ${index + 3}`}
          >
            <Icon name={link.icon} size={14} class="h-3.5 w-3.5" />
            <span>{link.label}</span>
          </Button>
        ))}
      </div>
    </nav>
  ) : null
}
