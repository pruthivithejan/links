---
import Avatar from "../ui/Avatar.astro";
import Card from "../ui/Card.astro";
import CardContent from "../ui/CardContent.astro";
import CardMedia from "../ui/CardMedia.astro";
import CardTitle from "../ui/CardTitle.astro";
import Icon from "../ui/Icon.astro";
import PreviewImage from "../ui/PreviewImage.astro";
import type { CardData } from "../../features/link-previews/model.ts";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;

const { meta } = card;
const displayName = name;
const bio = meta?.headline;
const avatar = meta?.avatar;
const banner = meta?.banner;

const stats = [
  meta?.followers === undefined ? "" : `${meta.followers} followers`,
  meta?.following === undefined ? "" : `${meta.following} following`,
  meta?.friends === undefined ? "" : `${meta.friends} friends`,
  meta?.mutual === undefined ? "" : `${meta.mutual} mutual`,
].filter(Boolean);
---

<Card href={card.href} index={index} kind="facebook" username={username}>
  {
    banner && (
      <CardMedia class="h-24 shrink-0">
        <PreviewImage
          classes="absolute inset-0 h-full w-full object-cover"
          src={banner}
        />
      </CardMedia>
    )
  }

  <CardContent
    class={`px-4 pb-4 md:px-5 md:pb-4 ${banner ? "" : "pt-4"}`}
  >
    <div class={`flex items-end justify-between ${banner ? "-mt-10" : ""}`}>
      <Avatar
        name={displayName}
        src={avatar}
        fallbackAvatar={meta?.fallbackAvatar}
        fallback="f"
        size="xl"
        class="border-4 border-(--card-bg) bg-[linear-gradient(135deg,#1877f2,#0c4082)] text-white"
      />
      <Icon name="facebook" size={24} class="mb-2 h-6 w-6 shrink-0 opacity-70" />
    </div>

    <div class="mt-2 flex min-h-0 flex-1 flex-col">
      <CardTitle as="h3" size="lg">{displayName}</CardTitle>
      <div class="mt-auto pt-3">
        {
          stats.length > 0 && (
            <p class="truncate text-sm text-(--text-muted)">
              {stats.join(" · ")}
            </p>
          )
        }
        {
          bio && (
            <p class="mt-2 line-clamp-3 text-sm leading-snug text-(--text-subtle)">
              {bio}
            </p>
          )
        }
      </div>
    </div>
  </CardContent>
</Card>
