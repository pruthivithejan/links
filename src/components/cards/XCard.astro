---
import Avatar from "../ui/Avatar.astro";
import Card from "../ui/Card.astro";
import CardContent from "../ui/CardContent.astro";
import CardMedia from "../ui/CardMedia.astro";
import Icon from "../ui/Icon.astro";
import PreviewImage from "../ui/PreviewImage.astro";
import type { CardData } from "../../features/link-previews/model.ts";

const formatCount = (value: number | string) => {
  const amount = Number(value);

  if (Number.isNaN(amount)) {
    return String(value);
  }

  return new Intl.NumberFormat("en", {
    maximumFractionDigits: 1,
    notation: "compact",
  }).format(amount);
};

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;
const { meta } = card;
const joinedDate = meta?.joined ? new Date(meta.joined) : undefined;

const joined =
  joinedDate && !Number.isNaN(joinedDate.getTime())
    ? joinedDate.toLocaleDateString("en-US", {
        month: "long",
        timeZone: "UTC",
        year: "numeric",
      })
    : undefined;
---

<Card href={card.href} index={index} kind="x" username={username}>
  <CardMedia class="h-28 shrink-0">
    {
      meta?.banner && (
        <PreviewImage
          src={meta.banner}
          classes="absolute inset-0 h-full w-full object-cover"
        />
      )
    }
  </CardMedia>

  <CardContent class="px-4 pb-4 md:px-5 md:pb-4">
    <div class="-mt-7 mb-1 flex items-end justify-between">
      <Avatar
        name={name}
        src={meta?.avatar}
        fallbackAvatar={meta?.fallbackAvatar}
        size="md"
        class="border-4 border-(--card-bg) bg-(--chip-bg)"
      >
        <Icon slot="fallback" name="x" size={20} class="h-5 w-5" />
      </Avatar>
      <Icon name="x" size={16} class="mb-1 h-4 w-4 shrink-0 opacity-60" />
    </div>

    <p class="truncate text-sm font-semibold leading-tight" data-x-name>
      {name}
    </p>
    <p class="truncate text-xs leading-tight text-(--text-muted)" data-x-handle>
      @{username}
    </p>
    {
      meta?.headline && (
        <p
          class="mt-2 line-clamp-2 text-xs leading-snug text-(--text-subtle)"
          data-x-bio
        >
          {meta.headline}
        </p>
      )
    }

    <div class="mt-auto flex items-center gap-3 pt-2 text-[11px] text-(--text-muted)">
      {joined && <span class="truncate" data-x-joined>Joined {joined}</span>}
      {
        meta?.following !== undefined && (
          <span class="ml-auto whitespace-nowrap">
            <b class="font-semibold text-(--foreground)" data-x-following>
              {formatCount(meta.following)}
            </b>{" "}
            Following
          </span>
        )
      }
      {
        meta?.followers !== undefined && (
          <span class="whitespace-nowrap">
            <b class="font-semibold text-(--foreground)" data-x-followers>
              {formatCount(meta.followers)}
            </b>{" "}
            Followers
          </span>
        )
      }
    </div>
  </CardContent>
</Card>
