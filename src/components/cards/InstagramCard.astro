---
import CardShell from "./CardShell.astro";
import type { CardData } from "./types";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;

const { meta } = card;
const displayName = meta?.name || name || username;
const bio = meta?.headline;
const avatar = meta?.avatar;

const initials = displayName
  .split(/\s+/u)
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();

const metrics = [
  meta?.posts === undefined ? "" : `${meta.posts} posts`,
  meta?.followers === undefined ? "" : `${meta.followers} followers`,
  meta?.following === undefined ? "" : `${meta.following} following`,
].filter(Boolean);
---

<CardShell card={card} index={index} kind="instagram" username={username}>
  <div class="flex h-full flex-col px-4 py-4 md:px-5">
    <div class="flex items-center gap-3">
      <div class="shrink-0 rounded-full bg-[conic-gradient(from_180deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5,#feda75)] p-[3px]">
        <div class="rounded-full bg-(--card-bg) p-[3px]">
          <div class="relative flex h-18 w-18 items-center justify-center overflow-hidden rounded-full bg-(--chip-bg) text-base font-semibold text-(--text-muted)">
            <span
              class="absolute inset-0 flex items-center justify-center"
              aria-hidden="true"
            >
              {initials || "ig"}
            </span>
            {
              avatar && (
                <img
                  src={avatar}
                  alt=""
                  class="relative h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  data-card-avatar
                  data-fallback-avatar={meta?.fallbackAvatar}
                />
              )
            }
          </div>
        </div>
      </div>

      <div class="min-w-0">
        <div class="flex items-center gap-1.5">
          <p class="truncate text-base font-semibold leading-tight">
            {username}
          </p>
          <img
            src="/icons/instagram.svg"
            alt=""
            class="h-4 w-4 shrink-0 opacity-70 filter-(--icon-filter)"
            width={16}
            height={16}
          />
        </div>
        <p class="mt-1 truncate text-sm leading-tight text-(--text-muted)">
          {displayName}
        </p>
      </div>
    </div>

    <div class="mt-auto pt-4">
      {
        metrics.length > 0 && (
          <div class="flex items-center gap-4 text-sm">
            {metrics.map((metric) => {
              const [value, ...label] = metric.split(" ");
              return (
                <span class="whitespace-nowrap text-(--text-muted)">
                  <b class="font-semibold text-(--foreground)">{value}</b>{" "}
                  {label.join(" ")}
                </span>
              );
            })}
          </div>
        )
      }

      {bio && <p class="mt-3 line-clamp-3 text-sm leading-snug text-(--text-subtle)">{bio}</p>}
    </div>
  </div>
</CardShell>
