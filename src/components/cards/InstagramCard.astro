---
import Avatar from "../ui/Avatar.astro";
import Card from "../ui/Card.astro";
import CardContent from "../ui/CardContent.astro";
import CardTitle from "../ui/CardTitle.astro";
import Icon from "../ui/Icon.astro";
import type { CardData } from "../../features/link-previews/model.ts";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;

const { meta } = card;
const displayName = name;
const bio = meta?.headline;
const avatar = meta?.avatar;

const metrics = [
  meta?.posts === undefined ? "" : `${meta.posts} posts`,
  meta?.followers === undefined ? "" : `${meta.followers} followers`,
  meta?.following === undefined ? "" : `${meta.following} following`,
].filter(Boolean);
---

<Card href={card.href} index={index} kind="instagram" username={username}>
  <CardContent class="px-4 py-4 md:px-5">
    <div class="flex items-center gap-3">
      <div class="shrink-0 rounded-full bg-[conic-gradient(from_180deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5,#feda75)] p-[3px]">
        <div class="rounded-full bg-(--card-bg) p-[3px]">
          <Avatar
            name={displayName}
            src={avatar}
            fallbackAvatar={meta?.fallbackAvatar}
            fallback="ig"
            size="lg"
            class="bg-(--chip-bg) text-(--text-muted)"
          />
        </div>
      </div>

      <div class="min-w-0">
        <div class="flex items-center gap-1.5">
          <CardTitle as="p">{username}</CardTitle>
          <Icon
            name="instagram"
            size={16}
            class="h-4 w-4 shrink-0 opacity-70"
          />
        </div>
        <p class="mt-1 truncate text-sm leading-tight text-(--text-muted)">
          {displayName}
        </p>
      </div>
    </div>

    <div class="mt-auto pt-4">
      {
        metrics.length > 0 && (
          <div class="flex items-center gap-4 text-sm">
            {metrics.map((metric) => {
              const [value, ...label] = metric.split(" ");
              return (
                <span class="whitespace-nowrap text-(--text-muted)">
                  <b class="font-semibold text-(--foreground)">{value}</b>{" "}
                  {label.join(" ")}
                </span>
              );
            })}
          </div>
        )
      }

      {
        bio && (
          <p class="mt-3 line-clamp-3 text-sm leading-snug text-(--text-subtle)">
            {bio}
          </p>
        )
      }
    </div>
  </CardContent>
</Card>
