---
import CardShell from "./CardShell.astro";
import type { CardData } from "./types";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;
const { meta } = card;
const contributions = meta?.contributions?.slice(-119);
---

<CardShell card={card} index={index} kind="github" username={username}>
  <div class="flex h-full flex-col p-4 pb-4 md:p-5 md:pb-4">
    <div class="mb-3 flex items-center gap-3">
      {meta?.avatar && <img
        src={meta.avatar}
        alt=""
        class="h-10 w-10 shrink-0 rounded-full border border-(--border) bg-(--chip-bg) object-cover"
        width={40}
        height={40}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        data-card-avatar
        data-fallback-avatar={meta.fallbackAvatar}
      />}
      <div class="min-w-0">
        <p
          class="truncate text-sm font-semibold leading-tight"
          data-gh-name
        >
          {name}
        </p>
        <p class="truncate text-xs leading-tight text-(--text-muted)">
          @{username}
        </p>
      </div>
      <img
        src="/icons/github.svg"
        alt=""
        class="ml-auto h-5 w-5 shrink-0 filter-(--icon-filter)"
        width={20}
        height={20}
      />
    </div>

    {contributions && <div class="grid grid-flow-col grid-rows-7 gap-1" aria-hidden="true">
      {contributions.map((day) => (
        <div
          class="gh-cell h-3 w-3 rounded-[2px]"
          data-gh-cell
          data-level={day.level}
          title={`${day.count} contributions on ${day.date}`}
        />
      ))}
    </div>}

    {meta?.contributionsTotal !== undefined && <p
      class="mt-auto pt-3 font-[family-name:var(--font-body)] text-[11px] text-(--text-muted)"
      data-gh-total
    >
      {meta.contributionsTotal.toLocaleString()} contributions in {meta.contributionsYear}
    </p>}
  </div>
</CardShell>

<style>
  .gh-cell {
    background: color-mix(in oklab, var(--foreground) 8%, transparent);
    transition: transform 150ms ease;
  }

  .gh-cell[data-level="1"] {
    background: color-mix(in oklab, var(--foreground) 18%, transparent);
  }

  .gh-cell[data-level="2"] {
    background: color-mix(in oklab, var(--foreground) 34%, transparent);
  }

  .gh-cell[data-level="3"] {
    background: color-mix(in oklab, var(--foreground) 56%, transparent);
  }

  .gh-cell[data-level="4"] {
    background: color-mix(in oklab, var(--foreground) 82%, transparent);
  }

  .gh-cell:hover {
    transform: scale(1.25);
  }
</style>
