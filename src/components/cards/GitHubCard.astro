---
import Avatar from "../ui/Avatar.astro";
import Card from "../ui/Card.astro";
import CardContent from "../ui/CardContent.astro";
import Icon from "../ui/Icon.astro";
import type { CardData } from "../../features/link-previews/model.ts";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;
const { meta } = card;
const contributions = meta?.contributions?.slice(-119);
---

<Card href={card.href} index={index} kind="github" username={username}>
  <CardContent class="p-4 pb-4 md:p-5 md:pb-4">
    <div class="mb-3 flex items-center gap-3">
      {
        meta?.avatar && (
          <Avatar
            name={name}
            src={meta.avatar}
            fallbackAvatar={meta.fallbackAvatar}
            class="border border-(--border) bg-(--chip-bg)"
          />
        )
      }
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold leading-tight" data-gh-name>
          {name}
        </p>
        <p class="truncate text-xs leading-tight text-(--text-muted)">
          @{username}
        </p>
      </div>
      <Icon name="github" size={20} class="ml-auto h-5 w-5 shrink-0" />
    </div>

    {
      contributions && (
        <div
          class="grid grid-flow-col grid-rows-7 gap-1"
          aria-hidden="true"
        >
          {contributions.map((day) => (
            <div
              class="gh-cell h-3 w-3 rounded-[2px]"
              data-gh-cell
              data-level={day.level}
              title={`${day.count} contributions on ${day.date}`}
            />
          ))}
        </div>
      )
    }

    {
      meta?.contributionsTotal !== undefined && (
        <p
          class="mt-auto pt-3 font-[family-name:var(--font-body)] text-[11px] text-(--text-muted)"
          data-gh-total
        >
          {meta.contributionsTotal.toLocaleString()} contributions in{" "}
          {meta.contributionsYear}
        </p>
      )
    }
  </CardContent>
</Card>

<style>
  .gh-cell {
    background: color-mix(in oklab, var(--foreground) 8%, transparent);
    transition: transform 150ms ease;
  }

  .gh-cell[data-level="1"] {
    background: color-mix(in oklab, var(--foreground) 18%, transparent);
  }

  .gh-cell[data-level="2"] {
    background: color-mix(in oklab, var(--foreground) 34%, transparent);
  }

  .gh-cell[data-level="3"] {
    background: color-mix(in oklab, var(--foreground) 56%, transparent);
  }

  .gh-cell[data-level="4"] {
    background: color-mix(in oklab, var(--foreground) 82%, transparent);
  }

  .gh-cell:hover {
    transform: scale(1.25);
  }
</style>
