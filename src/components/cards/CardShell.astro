---
import type { CardData, CardKind } from "./types";

interface Props {
  autoHeight?: boolean;
  card: CardData;
  index: number;
  kind: CardKind;
  username?: string;
}

const { autoHeight = false, card, index, kind, username = "" } = Astro.props;
---

<article class="min-w-0">
  <a
    href={card.href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "group relative flex w-full flex-col overflow-hidden rounded-(--radius-card) border border-(--card-border) bg-(--card-bg) text-(--foreground) no-underline opacity-0 shadow-(--shadow-card) transition-[border-color,box-shadow,background-color] duration-150 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] hover:border-(--card-border-hover) hover:bg-(--card-bg-hover) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--icon-color)",
      autoHeight ? "h-auto" : "h-[16.5rem]",
    ]}
    style={`--stagger: ${index + 3}`}
    data-card
    data-kind={kind}
    data-username={username}
  >
    <slot />
  </a>
</article>
