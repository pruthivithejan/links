---
import CardShell from "./CardShell.astro";
import type { CardData } from "./types";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;

const { meta } = card;
const displayName = meta?.name || name || username;
const headline = meta?.headline;
const avatar = meta?.avatar;
const banner = meta?.banner;

const initials = displayName
  .split(/\s+/u)
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<CardShell card={card} index={index} kind="linkedin" username={username}>
  <div class="flex h-full flex-col">
    {
      banner && (
        <div class="relative h-20 w-full shrink-0 overflow-hidden">
          <img
            src={banner}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            data-social-image
          />
        </div>
      )
    }

    <div
      class={`flex min-h-0 flex-1 flex-col px-4 pb-4 md:px-5 md:pb-4 ${banner ? "" : "pt-4"}`}
    >
      <div
        class={`flex items-end justify-between ${banner ? "-mt-10" : ""}`}
      >
        <div class="relative flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-full border-4 border-(--card-bg) bg-[linear-gradient(135deg,#0a66c2,#004182)] text-lg font-semibold text-white">
          <span
            class="absolute inset-0 flex items-center justify-center"
            aria-hidden="true"
          >
            {initials || "in"}
          </span>
          {
            avatar && (
              <img
                src={avatar}
                alt=""
                class="relative h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                data-card-avatar
                data-fallback-avatar={meta?.fallbackAvatar}
              />
            )
          }
        </div>
        <img
          src="/icons/linkedin.svg"
          alt=""
          class="mb-2 h-6 w-6 shrink-0 opacity-70 filter-(--icon-filter)"
          width={24}
          height={24}
        />
      </div>

      <div class="mt-2 flex min-h-0 flex-1 flex-col">
        <h3 class="truncate text-lg font-semibold leading-tight">
          {displayName}
        </h3>
        {headline && <p class="mt-1 line-clamp-2 text-sm leading-snug text-(--text-muted)">{headline}</p>}
        {
          meta?.location && (
            <p class="mt-1 truncate text-xs text-(--text-muted)">
              {meta.location}
            </p>
          )
        }
        {
          meta?.connections !== undefined && (
            <p class="mt-auto pt-2 text-xs font-semibold text-(--foreground)">
              {meta.connections} connections
            </p>
          )
        }
      </div>
    </div>
  </div>
</CardShell>
