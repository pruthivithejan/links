---
import Avatar from "../ui/Avatar.astro";
import Card from "../ui/Card.astro";
import CardContent from "../ui/CardContent.astro";
import CardMedia from "../ui/CardMedia.astro";
import CardTitle from "../ui/CardTitle.astro";
import Icon from "../ui/Icon.astro";
import PreviewImage from "../ui/PreviewImage.astro";
import type { CardData } from "../../features/link-previews/model.ts";

interface Props {
  card: CardData;
  index: number;
  name: string;
  username: string;
}

const { card, index, name, username } = Astro.props;

const { meta } = card;
const displayName = name;
const headline = meta?.headline;
const avatar = meta?.avatar;
const banner = meta?.banner;
---

<Card href={card.href} index={index} kind="linkedin" username={username}>
  {
    banner && (
      <CardMedia class="h-20 shrink-0">
        <PreviewImage
          classes="absolute inset-0 h-full w-full object-cover"
          src={banner}
        />
      </CardMedia>
    )
  }

  <CardContent
    class={`px-4 pb-4 md:px-5 md:pb-4 ${banner ? "" : "pt-4"}`}
  >
    <div class={`flex items-end justify-between ${banner ? "-mt-10" : ""}`}>
      <Avatar
        name={displayName}
        src={avatar}
        fallbackAvatar={meta?.fallbackAvatar}
        fallback="in"
        size="xl"
        class="border-4 border-(--card-bg) bg-[linear-gradient(135deg,#0a66c2,#004182)] text-white"
      />
      <Icon name="linkedin" size={24} class="mb-2 h-6 w-6 shrink-0 opacity-70" />
    </div>

    <div class="mt-2 flex min-h-0 flex-1 flex-col">
      <CardTitle as="h3" size="lg">{displayName}</CardTitle>
      {
        headline && (
          <p class="mt-1 line-clamp-2 text-sm leading-snug text-(--text-muted)">
            {headline}
          </p>
        )
      }
      {
        meta?.location && (
          <p class="mt-1 truncate text-xs text-(--text-muted)">
            {meta.location}
          </p>
        )
      }
      {
        meta?.connections !== undefined && (
          <p class="mt-auto pt-2 text-xs font-semibold text-(--foreground)">
            {meta.connections} connections
          </p>
        )
      }
    </div>
  </CardContent>
</Card>
