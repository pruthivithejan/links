---
import Card from "./ui/Card.astro";
import CardDescription from "./ui/CardDescription.astro";
import CardHeader from "./ui/CardHeader.astro";
import CardTitle from "./ui/CardTitle.astro";
import Icon from "./ui/Icon.astro";
import CopyLinkButton from "./links/CopyLinkButton.astro";
import type { SmallLink } from "../content/schemas.ts";

interface Props {
  links: SmallLink[];
}

const { links } = Astro.props;
---

<section class="w-full flex justify-center">
  <div
    class="grid w-full max-w-200 auto-rows-fr grid-cols-1 items-stretch gap-4 px-4 lg:grid-cols-2"
  >
    {
      links.map((card, index) => (
        <Card
          interactive
          index={index}
          overflow="visible"
          class="h-full"
        >
          <a
            href={card.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-full cursor-pointer flex-col p-4 text-(--foreground) no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--icon-color) md:p-5"
          >
            <CardHeader class="mb-2 gap-2">
              <Icon name={card.icon} size={24} class="h-6 w-6" />
              <CardTitle as="h2" class="text-base sm:text-lg">
                {card.title}
              </CardTitle>
              <span
                class="inline-block font-mono transition-transform duration-200 group-hover:animate-[card-hover-arrow_200ms_forwards]"
                aria-hidden="true"
              >
                <Icon src="/arrow-right.svg" size={16} class="h-8 w-8" />
              </span>
            </CardHeader>
            <CardDescription class="max-w-none text-sm md:max-w-[34ch]">
              {card.description}
            </CardDescription>
          </a>
          <CopyLinkButton href={card.href} />
        </Card>
      ))
    }
  </div>
</section>
