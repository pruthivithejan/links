---
import '../styles/global.css';
import {
	DEFAULT_AVATAR_ID,
	DEFAULT_FONT_ID,
	DEFAULT_PALETTE_ID,
	GOOGLE_FONTS_HREF,
	THEME_AVATAR_VARIABLES,
	THEME_FONT_VARIABLES,
	THEME_MODES,
	THEME_PALETTES,
	THEME_BOOT_STATE_ATTRIBUTE,
	THEME_STORAGE_KEY,
} from '../features/theme/registry';
import { THEME_TOKEN_KEYS } from '../features/theme/colors';

const themeBootConfig = {
	avatars: THEME_AVATAR_VARIABLES,
	defaults: {
		avatar: DEFAULT_AVATAR_ID,
		font: DEFAULT_FONT_ID,
		palette: DEFAULT_PALETTE_ID,
	},
	fonts: THEME_FONT_VARIABLES,
	modes: THEME_MODES,
	palettes: Object.fromEntries(THEME_PALETTES.map(({ id, accent }) => [id, accent])),
	stateAttribute: THEME_BOOT_STATE_ATTRIBUTE,
	storageKey: THEME_STORAGE_KEY,
	tokenKeys: THEME_TOKEN_KEYS,
};

interface Props {
	title: string;
	description: string;
	favicon: {
		light: string;
		dark: string;
	};
}

const { title, description, favicon } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/svg+xml"
			href={favicon.light}
			media="(prefers-color-scheme: light)"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href={favicon.dark}
			media="(prefers-color-scheme: dark)"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href={GOOGLE_FONTS_HREF} rel="stylesheet" />
		<script is:inline define:vars={{ themeBootConfig }}>
			const normalizeTheme = (stored, config, systemMode) => {
				const palette = Object.keys(config.palettes).find(
					(id) => id === stored?.palette,
				) ?? config.defaults.palette;

				const mode = config.modes.find(
					(option) => option.id === stored?.mode,
				)?.id ?? systemMode;

				const avatar = Object.keys(config.avatars).find(
					(id) => id === stored?.avatar,
				) ?? config.defaults.avatar;

				const font = Object.keys(config.fonts).find(
					(id) => id === stored?.font,
				) ?? config.defaults.font;

				const headingFont = Object.keys(config.fonts).find(
					(id) => id === stored?.headingFont,
				) ?? config.defaults.font;

				return {
					avatar,
					borders: stored?.borders !== false,
					font,
					headingFont,
					mode,
					palette,
					shadows: stored?.shadows !== false,
				};
			};

			const applyTokens = (root, tokens, tokenKeys) => {
				if (!tokens) {return;}

				for (const [property, value] of Object.entries(tokens)) {
					if (tokenKeys.includes(property)) {
						root.style.setProperty(property, value);
					}
				}
			};

			const applyFont = (root, fonts, id, properties) => {
				const variables = fonts?.[id];

				if (!variables) {return;}

				for (const property of properties) {
					root.style.setProperty(property, variables[property]);
				}
			};

			const applyAvatar = (root, avatars, id) => {
				const variables = avatars?.[id];

				if (!variables) {return;}

				for (const [property, value] of Object.entries(variables)) {
					root.style.setProperty(property, value);
				}
			};

			(() => {
				const root = document.documentElement;
				const config = themeBootConfig;

				const isSystemDark = window.matchMedia(
					'(prefers-color-scheme: dark)',
				).matches;

				const readTheme = () => {
					try {
						const raw = localStorage.getItem(config.storageKey);

						return raw ? JSON.parse(raw) : null;
					} catch {
						return null;
					}
				};

				const stored = readTheme();
				const systemMode = isSystemDark ? 'dark' : 'light';
				const theme = normalizeTheme(stored, config, systemMode);
				const isDark = theme.mode === 'dark';
				root.dataset[config.stateAttribute] = JSON.stringify(theme);

				root.classList.toggle('dark', isDark);

				applyTokens(
					root,
					isDark ? stored?.tokens?.dark : stored?.tokens?.light,
					config.tokenKeys,
				);

				if (theme?.borders === false) {root.dataset.borders = 'off';}

				if (theme?.shadows === false) {root.dataset.shadows = 'off';}

				applyFont(root, config.fonts, theme?.font, ['--font-body', '--font-tracking', '--font-leading', '--font-style']);
				applyFont(root, config.fonts, theme?.headingFont, ['--font-heading', '--font-heading-tracking', '--font-heading-leading', '--font-heading-style']);
				applyAvatar(root, config.avatars, theme?.avatar);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
