---
import '../styles/global.css';
import {
	GOOGLE_FONTS_HREF,
	THEME_FONT_VARIABLES,
	THEME_STORAGE_KEY,
} from '../features/theme/registry';
import { THEME_TOKEN_KEYS } from '../features/theme/colors';

const themeBootConfig = {
	fonts: THEME_FONT_VARIABLES,
	storageKey: THEME_STORAGE_KEY,
	tokenKeys: THEME_TOKEN_KEYS,
};

interface Props {
	title?: string;
}

const { title = 'Pruthivi Thejan | Links' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Pruthivi Thejan Links - Explore all my profiles and projects" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/pruthivi.svg"
			media="(prefers-color-scheme: light)"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/pruthivi-light.svg"
			media="(prefers-color-scheme: dark)"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href={GOOGLE_FONTS_HREF} rel="stylesheet" />
		<script is:inline define:vars={{ themeBootConfig }}>
			(() => {
				const root = document.documentElement;
				const config = themeBootConfig;

				const isSystemDark = window.matchMedia(
					'(prefers-color-scheme: dark)',
				).matches;

				const readTheme = () => {
					try {
						const raw = localStorage.getItem(config.storageKey);

						return raw ? JSON.parse(raw) : null;
					} catch {
						return null;
					}
				};

				const theme = readTheme();
				const mode = theme?.mode;
				const isDark = mode === 'dark' || (mode !== 'light' && isSystemDark);

				root.classList.toggle('dark', isDark);

				if (theme?.tokens) {
					const tokens = isDark ? theme.tokens.dark : theme.tokens.light;

					if (tokens) {
						for (const [property, value] of Object.entries(tokens)) {
							if (config.tokenKeys.includes(property)) {
								root.style.setProperty(property, value);
							}
						}
					}
				}

				const attributes = {
					avatar: theme?.avatar,
					borders: theme?.borders === false ? 'off' : undefined,
					shadows: theme?.shadows === false ? 'off' : undefined,
				};

				for (const [name, value] of Object.entries(attributes)) {
					if (value) {
						root.dataset[name] = value;
					}
				}

				const applyFont = (id, properties) => {
					const variables = config.fonts?.[id];

					if (!variables) {return;}

					for (const property of properties) {
						root.style.setProperty(property, variables[property]);
					}
				};

				applyFont(theme?.font, ['--font-body', '--font-tracking', '--font-leading', '--font-style']);
				applyFont(theme?.headingFont, ['--font-heading', '--font-heading-tracking', '--font-heading-leading', '--font-heading-style']);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
