---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Links from "../components/Links.astro";
import QuickLinks from "../components/QuickLinks.astro";
import personalData from "../content/personal/profile.json";
import linksArray from "../content/links/links.json";
import quickLinksArray from "../content/quick-links/quick-links.json";

const personal = personalData;
const links = (linksArray || []) as Array<{
	href: string;
	icon: string;
	title: string;
	description: string;
}>;

const quickLinks = (quickLinksArray || []) as Array<{
	href: string;
	icon: string;
	label: string;
	preview?: {
		title?: string;
		description?: string;
		meta?: string;
		image?: string;
	};
}>;

const githubUsername = personal?.githubUsername || "";
const profileName = personal?.profileName || githubUsername;
const profileBio = personal?.profileBio || "";
---

<Layout title={personal?.heading}>
	<main
		class="flex flex-col justify-between items-center min-h-screen w-full gap-8 md:gap-12 px-4 py-10 sm:px-6 sm:py-12 md:p-24 pt-24"
	>
		<Hero
			githubUsername={githubUsername}
			profileName={profileName}
			profileBio={profileBio}
		/>

		<QuickLinks links={quickLinks} />
		<Links links={links} />

		<!-- Footer: Quote on left, Build Your Own on right -->
		<footer class="w-full flex justify-center mt-12 md:mt-16">
			<div
				class="z-10 flex w-full max-w-[1100px] flex-col items-center justify-between gap-4 px-4 pb-4 text-sm opacity-0 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] md:flex-row"
				style={`--stagger: 4`}
			>
				<p
					class="relative m-0 rounded-[var(--radius-card)] bg-[color:var(--card-bg)] p-4 text-center font-['InstrumentSerif-Italic',serif] tracking-[1px] text-[color:var(--foreground)] shadow-[var(--shadow-card)] md:text-left"
				>
					"{personal?.slogan?.words}&nbsp;
					<code
						class="font-['JetBrains_Mono',monospace] font-bold tracking-[1px]"
						>{personal?.slogan?.highlight}</code
					>."
				</p>
				<a
					href={`https://github.com/${personal?.githubUsername}/${personal?.codeRepository}`}
					target="_blank"
					rel="noopener noreferrer"
					class="hidden h-9 items-center justify-center gap-2 rounded-[var(--radius-chip)] bg-[color:var(--chip-bg)] px-[13px] font-['JetBrains_Mono',monospace] text-[color:var(--icon-color-muted)] shadow-[var(--shadow-border)] transition-colors duration-150 hover:text-[color:var(--icon-color)] md:inline-flex"
				>
					Build Your Own
					<img
						src="/icons/github.svg"
						alt="Github Logo"
						class="h-6 w-6 [filter:var(--icon-filter)] transition-[filter] duration-200"
						width={24}
						height={24}
					/>
				</a>
			</div>
		</footer>
	</main>
</Layout>
