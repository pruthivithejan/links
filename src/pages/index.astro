---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SmallLinks from "../components/SmallLinks.astro";
import LinkCards from "../components/LinkCards.astro";
import QuickLinks from "../components/QuickLinks.astro";
import ThemeLab from "../components/ThemeLab.astro";
import { linkSections, personal } from "../content/registry.ts";

---

<Layout
  title={personal.heading}
  description={personal.description}
  favicon={personal.favicon}
>
  <main
    class="flex flex-col justify-between items-center min-h-screen w-full gap-8 md:gap-12 px-(--page-inline-padding) pb-10 sm:pb-12 md:pb-24 pt-8"
  >
    <Hero
      githubUsername={personal.githubUsername}
      profileName={personal.profileName}
      profileBio={personal.profileBio}
    />

    <QuickLinks links={linkSections.quick} />
    <LinkCards links={linkSections.rich} />
    <SmallLinks links={linkSections.small} />

    <footer class="w-full flex justify-center mt-12 md:mt-16">
      <div
        class="z-10 flex w-full max-w-200 flex-col items-center justify-between gap-4 px-4 pb-4 text-sm opacity-0 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] md:flex-row"
        style={`--stagger: 4`}
      >
        <p
          class="m-0 max-w-150 text-center font-[inherit] leading-(--font-leading) tracking-(--font-tracking) text-[color:var(--foreground)] md:text-left"
        >
          "{personal.slogan.words}&nbsp;
          <code
            class="font-[inherit] font-bold"
            >{personal.slogan.highlight}</code
          >."
        </p>
        <nav class="flex flex-wrap items-center justify-center gap-3" aria-label="Page links">
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/$/u, "")}/share/`}
          class="site-pill"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM20 14v3M14 20h3M20 20h1v1h-1z" />
          </svg>
          Share profile
        </a>
        <a
          href={`https://github.com/${personal.githubUsername}/${personal.codeRepository}`}
          target="_blank"
          rel="noopener noreferrer"
          class="site-pill hidden md:inline-flex"
        >
          Build Your Own
          <img
            src="/icons/github.svg"
            alt="Github Logo"
            class="h-6 w-6 filter-(--icon-filter) transition-[filter] duration-200"
            width={24}
            height={24}
          />
        </a>
        </nav>
      </div>
    </footer>
  </main>

  <ThemeLab />
</Layout>
