---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Links from "../components/Links.astro";
import LinkCards from "../components/LinkCards.astro";
import QuickLinks from "../components/QuickLinks.astro";
import ThemeLab from "../components/ThemeLab.astro";
import personalData from "../content/personal/profile.json";
import linksArray from "../content/links/links.json";
import quickLinksArray from "../content/quick-links/quick-links.json";
import linkCardsArray from "../content/link-cards/link-cards.json";

const personal = personalData;

const links = linksArray || [];
const quickLinks = quickLinksArray || [];
const profileCards = linkCardsArray || [];

const githubUsername = personal?.githubUsername || "";
const profileName = personal?.profileName || githubUsername;
const profileBio = personal?.profileBio || "";

---

<Layout title={personal?.heading}>
  <main
    class="flex flex-col justify-between items-center min-h-screen w-full gap-8 md:gap-12 px-(--page-inline-padding) pb-10 sm:pb-12 md:pb-24 pt-8"
  >
    <Hero
      githubUsername={githubUsername}
      profileName={profileName}
      profileBio={profileBio}
    />

    <QuickLinks links={quickLinks} />
    <LinkCards links={profileCards} />
    <Links links={links} />

    <!-- Footer: Quote on left, Build Your Own on right -->
    <footer class="w-full flex justify-center mt-12 md:mt-16">
      <div
        class="z-10 flex w-full max-w-200 flex-col items-center justify-between gap-4 px-4 pb-4 text-sm opacity-0 animate-[enter_500ms_forwards] [animation-delay:calc(var(--stagger,0)*200ms)] md:flex-row"
        style={`--stagger: 4`}
      >
        <p
          class="m-0 max-w-150 text-center font-[inherit] leading-(--font-leading) tracking-(--font-tracking) text-[color:var(--foreground)] md:text-left"
        >
          "{personal?.slogan?.words}&nbsp;
          <code
            class="font-[inherit] font-bold"
            >{personal?.slogan?.highlight}</code
          >."
        </p>
        <a
          href={`https://github.com/${personal?.githubUsername}/${personal?.codeRepository}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden h-9 items-center justify-center gap-2 rounded-(--radius-chip) bg-(--chip-bg) px-[13px] font-[inherit] tracking-(--font-tracking) text-(--text-muted) shadow-(--shadow-border) transition-colors duration-150 hover:text-(--text-strong) md:inline-flex"
        >
          Build Your Own
          <img
            src="/icons/github.svg"
            alt="Github Logo"
            class="h-6 w-6 filter-(--icon-filter) transition-[filter] duration-200"
            width={24}
            height={24}
          />
        </a>
      </div>
    </footer>
  </main>

  <ThemeLab />
</Layout>
