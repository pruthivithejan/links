---
import Hero from "../components/Hero.astro";
import ShareQr from "../components/ShareQr.astro";
import ThemeLab from "../components/ThemeLab.astro";
import Button from "../components/ui/Button.astro";
import { linkSections, personal } from "../content/registry";
import { getShareContacts, shareLinkLabel } from "../features/share/contacts";
import Layout from "../layouts/Layout.astro";
import { assetUrl } from "../utils/asset.ts";

const name = personal.profileName || personal.githubUsername;
const homeUrl = new URL(personal.siteUrl).href;
const shareUrl = new URL("share/", `${homeUrl.replace(/\/$/u, "")}/`).href;
const contacts = getShareContacts(linkSections);
---

<Layout
  title={`Share ${name} | Links`}
  description={`Scan the QR code to explore ${name}'s links and get in touch.`}
  favicon={personal.favicon}
>
  <main class="share-page">
    <Button class="share-back" href={import.meta.env.BASE_URL} variant="pill">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7M5 12h14" />
      </svg>
      All links
    </Button>

    <div class="share-content">
      <div class="share-card" data-share-card>
      <Hero githubUsername={personal.githubUsername} profileName={personal.profileName} profileBio={personal.profileBio} compact />

      <figure class="share-code">
        <a class="share-qr-frame" href={shareUrl} aria-label={`Open ${name}'s share page`}>
          <ShareQr href={shareUrl} name={name} />
        </a>
        <figcaption>
          <span class="share-scan-label">Scan to connect</span>
          <a class="share-home-url" href={shareUrl}>{shareLinkLabel(shareUrl)}</a>
        </figcaption>
      </figure>

      {contacts.length > 0 && (
        <nav class="share-contacts" aria-label="Contact links">
          {contacts.map(({ href, icon, label }) => (
            <a class="share-contact" href={href}>
              <span class="share-contact-text">
                <span class="share-contact-label">{label}</span>
                <span class="share-contact-value">{shareLinkLabel(href)}</span>
              </span>
              <img src={assetUrl(`/icons/${icon}.svg`)} alt="" width="18" height="18" class="share-contact-icon" />
            </a>
          ))}
        </nav>
      )}
      </div>

      <div class="share-actions" data-share-actions>
        <Button type="button" class="share-action" data-share-copy data-share-url={shareUrl} variant="pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" />
            <path d="M4 16H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1" />
          </svg>
          <span data-share-copy-label aria-live="polite" aria-atomic="true">Copy link</span>
        </Button>
        <Button type="button" class="share-action" data-share-download variant="pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" />
          </svg>
          <span data-share-download-label aria-live="polite" aria-atomic="true">Save card</span>
        </Button>
      </div>
    </div>
  </main>

  <ThemeLab showQrControls />
</Layout>

<script src="../features/share/controller.ts"></script>

<style>
  .share-page {
    box-sizing: border-box;
    width: 100%;
    min-height: 100svh;
    padding: max(1.5rem, env(safe-area-inset-top)) var(--page-inline-padding) max(6rem, env(safe-area-inset-bottom));
  }

  .share-back svg,
  .share-action svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .share-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 24rem;
    margin: 0 auto;
  }

  .share-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .share-code {
    width: min(18rem, 85%);
    margin: 1.5rem 0 0;
  }

  .share-qr-frame {
    display: block;
    padding: 0.25rem;
    overflow: hidden;
    background: #ffffff;
    border-radius: calc(var(--radius-card) + 0.25rem);
    box-shadow: var(--material-shadow);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.5rem;
    text-align: center;
  }

  .share-scan-label {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .share-home-url {
    color: var(--text-strong);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .share-actions {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .share-actions[data-ready] {
    display: flex;
  }

  .share-action {
    min-width: 7.5rem;
  }

  .share-action:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .share-contacts {
    width: 100%;
    overflow: hidden;
    margin-top: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--card-bg);
    box-shadow: var(--shadow-card);
  }

  .share-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.75rem 1rem;
    color: var(--text-strong);
    text-decoration: none;
  }

  .share-contact + .share-contact {
    border-block-start: 1px solid var(--card-border);
  }

  .share-contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .share-contact-label {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .share-contact-value {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .share-contact-icon {
    flex: none;
    filter: var(--icon-filter);
    opacity: 0.6;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .share-contact:focus-visible {
    outline-offset: -3px;
  }
</style>
